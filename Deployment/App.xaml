<Application x:Class="Deployment.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Deployment"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Deployment.ViewModels"
             xmlns:views="clr-namespace:Deployment.Views"
             xmlns:enums="clr-namespace:Deployment.Core.Enums;assembly=Deployment.Core"
             xmlns:converters="clr-namespace:Deployment.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <converters:EnumToBooleanConverter
                x:Key="EnumToBooleanConverter" />
            <DataTemplate DataType="{x:Type vm:DeploymentModeViewModel}">
                <views:DeploymentModeView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
