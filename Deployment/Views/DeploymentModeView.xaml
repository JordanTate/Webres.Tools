<UserControl x:Class="Deployment.Views.DeploymentModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Deployment.Views"
             xmlns:enums="clr-namespace:Deployment.Core.Enums;assembly=Deployment.Core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel>
            <TextBlock 
                Text="Please select an option:"
                Margin="0,0,0,16"/>

            <RadioButton 
                Content="Preview"
                Margin="0,0,0,4"
                GroupName="DeploymentMode"
                IsChecked="{Binding SelectedMode,
                    Converter={StaticResource EnumToBooleanConverter},
                    ConverterParameter={x:Static enums:DeploymentMode.Preview}}" />

            <TextBlock
                Text="Perform a test deployment (no changes will be made)."
                Margin="0,0,0,16"
                Foreground="Gray" />

            <RadioButton 
                Content="Execute"
                Margin="0,0,0,4"
                GroupName="DeploymentMode"
                IsChecked="{Binding SelectedMode,
                    Converter={StaticResource EnumToBooleanConverter},
                    ConverterParameter={x:Static enums:DeploymentMode.Execute}}"/>
            
            <TextBlock
                Text="Perform a live deployment."
                Margin="0,0,0,16"
                Foreground="Gray" />

        </StackPanel>
    </Grid>
</UserControl>
