<UserControl x:Class="Deployment.UI.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Deployment.UI.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock
                Text="Connection Information"
                FontSize="24"
                FontWeight="SemiBold"
                Margin="0,0,0,32" />

            <TextBlock
               Text="Confirm the below database configuration is correct and test the connection before continuing."
               TextWrapping="Wrap"
               FontSize="20"
               Margin="0,0,0,16"
               Opacity="0.8" />

            <ui:CardControl
                HorizontalAlignment="Left"
                Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Server"
                            Opacity="0.8"
                            Margin="0,0,8,8"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Connection.ServerName}"
                            Margin="0,0,8,8" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Database"
                            Opacity="0.8"
                            Margin="0,0,8,8"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Connection.DatabaseName}"
                            Margin="0,0,8,8"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Authentication"
                            Opacity="0.8"
                            Margin="0,0,8,0"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Connection.AuthenticationType}"
                            Margin="0,0,8,0"/>
                    </Grid>
                </Grid>
            </ui:CardControl>

            <Border
                Margin="0,0,0,16"
                Padding="8"
                CornerRadius="4"
                Background="#162E1F"
                BorderBrush="#287A43"
                BorderThickness="1"
                Visibility="{Binding ValidationSucceeded, Converter={StaticResource BooleanToVisibilityConverter}}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        Symbol="CheckmarkCircle24"
                        FontSize="24"
                        Foreground="#4CC878"
                        VerticalAlignment="Top" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="16,0,0,0">

                        <TextBlock
                            Text="Connection Successful"
                            FontWeight="SemiBold"
                            Foreground="#6FE294"
                            Margin="0,0,8,0" />

                        <TextBlock
                            Text="The connection to the database was made successfully. You may now continue with deployment."
                            TextWrapping="Wrap"
                            Foreground="#C6E8CF" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="8"
                CornerRadius="4"
                Background="#351B1B"
                BorderBrush="#A83A3A"
                BorderThickness="1"
                Visibility="{Binding ValidationFailed, Converter={StaticResource BooleanToVisibilityConverter}}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        Symbol="DismissCircle24"
                        FontSize="24"
                        Foreground="#FF6B6B"
                        VerticalAlignment="Top" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="16,0,0,0">

                        <TextBlock
                            Text="Connection Failed"
                            FontWeight="SemiBold"
                            Foreground="#FF8585"
                            Margin="0,0,8,0" />

                        <TextBlock
                            Text="Unable to connect to database."
                            TextWrapping="Wrap"
                            Foreground="#F2CACA"
                            Margin="0,0,8,0" />

                        <TextBlock
                            Text="{Binding ErrorMessage, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Foreground="#F2CACA" />
                    </StackPanel>
                </Grid>
            </Border>

            <ui:Button
                IsEnabled="{Binding CanValidate}"
                Click="Validate_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock 
                        Text="Validate"
                        FontSize="16"
                        Margin="0,0,8,0" />
                    <ui:SymbolIcon Symbol="CloudArrowUp24" FontSize="16" />
                </StackPanel>
            </ui:Button>
        </StackPanel>

        <StackPanel 
            Grid.Row="1"
            Margin="8">
            <ui:Button
                HorizontalAlignment="Right"
                IsEnabled="{Binding ValidationSucceeded}"
                Click="Continue_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock 
                        Text="Continue"
                        FontSize="16"
                        Margin="0,0,8,0" />
                    <ui:SymbolIcon Symbol="ArrowRight24" />
                </StackPanel>
            </ui:Button>
        </StackPanel>
    </Grid>
</UserControl>
