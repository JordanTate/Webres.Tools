<UserControl x:Class="Deployment.UI.Views.DeploymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Deployment.UI.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Text="Deploy"
                FontSize="24"
                FontWeight="SemiBold"
                Margin="0,0,0,32" />

            <TextBlock
                Grid.Row="1"
                Text="{Binding Status}"
                Visibility="{Binding IsDeploying, Converter={StaticResource BooleanToVisibilityConverter}}"
                FontSize="20"
                Margin="0,0,0,16" />

            <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                Margin="0,0,0,16"
                Visibility="{Binding IsSuccess,Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:SymbolIcon
                    Symbol="CheckmarkCircle24"
                    FontSize="24"
                    Foreground="#4CC878"
                    VerticalAlignment="Bottom"
                    Margin="0,0,8,0"/>

                <TextBlock
                    Text="{Binding Status}"
                    Foreground="#6FE294"
                    FontSize="20" />
            </StackPanel>

            <StackPanel
                Grid.Row="3"
                Orientation="Horizontal"
                Margin="0,0,0,16"
                Visibility="{Binding IsFailure, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:SymbolIcon
                    Symbol="CheckmarkCircle24"
                    FontSize="24"
                    Foreground="#FF6B6B"
                    VerticalAlignment="Bottom"
                    Margin="0,0,8,0"/>

                <TextBlock
                    Text="{Binding Status}"
                    Foreground="#F2CACA"
                    FontSize="20" />
            </StackPanel>

            <TextBox
                Grid.Row="4"
                Text="{Binding LogText, Mode=OneWay}"
                IsReadOnly="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="8"
                Margin="0,0,0,16"
                BorderThickness="0"
                Opacity="0.8" />

            <StackPanel Grid.Row="5"  Visibility="{Binding IsComplete, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="16"
                    Opacity="0.8"
                    Text="Select one of the following options:" />
                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,0,0,16">
                    <ui:Button Margin="0,0,8,0" Click="NewDeploymentButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock 
                                Text="Start a New Deployment"
                                FontSize="16"
                                Margin="0,0,8,0" />
                            <ui:SymbolIcon Symbol="ArrowClockwise24" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Click="FinishButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock 
                                Text="Close Application"
                                FontSize="16"
                                Margin="0,0,8,0" />
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <ProgressBar
            Grid.Row="2"
            Height="8"
            Margin="0,0,0,16"
            Minimum="0"
            Maximum="100"
            IsEnabled="{Binding IsDeploying}"
            Value="{Binding Progress, Mode=OneWay}" />
    </Grid>
</UserControl>
