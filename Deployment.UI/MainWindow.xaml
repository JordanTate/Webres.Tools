<ui:FluentWindow x:Class="Deployment.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Deployment.UI"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="WebRes Deployment Tool" 
        Height="720" 
        Width="1280" 
        MinHeight="480" 
        MinWidth="720"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->

        <ui:TitleBar
            Grid.Row="0"
            Title="WebRes Deployment Tool"
            CloseWindowByDoubleClickOnIcon="True" />

        <!-- Header -->
        <Border Grid.Row="1"
                Padding="24,16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Symbol="ArrowDownload24"
                        FontSize="24"
                        Margin="0,0,12,0" />

                    <StackPanel>
                        <TextBlock
                            Text="WebRes Deployment Tool"
                            FontSize="24"
                            FontWeight="SemiBold" />
                    </StackPanel>

                    
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Border
                Grid.Column="0"
                Padding="16">


                <StackPanel>
                    <TextBlock
                        Text="DEPLOYMENT"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.6"
                        Margin="8,8,8,12" />

                    <ui:NavigationView
                        Grid.Column="0"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleVisible="False">
                        <ui:NavigationView.MenuItems>
                            <ui:NavigationViewItem
                                Content="Settings"
                                Click="Settings_Click"
                                Icon="{ui:SymbolIcon Symbol=Settings24}" />
                        </ui:NavigationView.MenuItems>
                    </ui:NavigationView>

                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Padding="48,36">
                <ContentControl 
                    x:Name="MainContent"
                    Padding="32" />
            </Border>
        </Grid>

        <!-- Footer -->
        <Border
            Grid.Row="3"
            Padding="24, 14">
        </Border>
    </Grid>
</ui:FluentWindow>
